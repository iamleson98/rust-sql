# SLT cases — NULL three-valued logic: comparisons, arithmetic, aggregates,
# DISTINCT/GROUP BY, IN/BETWEEN/LIKE with NULLs, COALESCE/IFNULL/NULLIF.

statement ok
CREATE TABLE n (id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO n (a, b) VALUES (1, 'x'), (NULL, 'y'), (3, NULL), (NULL, NULL), (2, 'z')

# NULL = NULL is NULL (not true), so WHERE never matches it.
query I
SELECT COUNT(*) FROM n WHERE a = NULL
----
0

query I
SELECT COUNT(*) FROM n WHERE NULL
----
0

# IS NULL / IS NOT NULL are the only NULL-safe predicates.
query I
SELECT COUNT(*) FROM n WHERE a IS NULL
----
2

query I
SELECT COUNT(*) FROM n WHERE b IS NOT NULL
----
3

# Arithmetic with NULL yields NULL.
query I
SELECT COUNT(*) FROM n WHERE a + 1 IS NULL
----
2

# NULL in CASE branches.
query TI rowsort
SELECT b, CASE WHEN a IS NULL THEN 'null' ELSE 'set' END FROM n
----
NULL null
NULL set
x set
y null
z set

# Aggregates skip NULLs; COUNT(*) does not.
query III
SELECT COUNT(*), COUNT(a), COUNT(b) FROM n
----
5 3 3

# SUM/AVG/MIN/MAX of a column with NULLs uses only non-NULL values.
query IIII
SELECT SUM(a), AVG(a), MIN(a), MAX(a) FROM n
----
6 2.0 1 3

# Aggregates over an all-NULL set are NULL (except COUNT).
statement ok
CREATE TABLE e (x INTEGER)

statement ok
INSERT INTO e VALUES (NULL), (NULL)

query IIIII
SELECT COUNT(*), COUNT(x), SUM(x), MIN(x), MAX(x) FROM e
----
2 0 NULL NULL NULL

# GROUP BY puts all NULLs in one group.
query II rowsort
SELECT a, COUNT(*) FROM n GROUP BY a
----
1 1
2 1
3 1
NULL 2

# DISTINCT collapses NULLs to one row.
query I
SELECT COUNT(*) FROM (SELECT DISTINCT a FROM n)
----
4

# IN with NULL on the left is never true.
query I
SELECT COUNT(*) FROM n WHERE a IN (1, 2, 3)
----
3

query I
SELECT COUNT(*) FROM n WHERE NULL IN (1, 2, 3)
----
0

query I
SELECT COUNT(*) FROM n WHERE 1 IN (2, NULL)
----
0

# NOT IN with a NULL in the list matches nothing.
query I
SELECT COUNT(*) FROM n WHERE 1 NOT IN (2, NULL)
----
0

# BETWEEN with NULL bounds.
query I
SELECT COUNT(*) FROM n WHERE a BETWEEN NULL AND 10
----
0

# LIKE against NULL.
query I
SELECT COUNT(*) FROM n WHERE b LIKE NULL
----
0

query I
SELECT COUNT(*) FROM n WHERE NULL LIKE 'x'
----
0

# COALESCE / IFNULL / NULLIF.
query T
SELECT COALESCE(NULL, NULL, 'fallback')
----
fallback

query I
SELECT IFNULL(NULL, 42)
----
42

query I
SELECT NULLIF(5, 5)
----
NULL

query I
SELECT NULLIF(5, 6)
----
5

# ORDER BY: NULLs sort first ascending.
query II nosort
SELECT a, id FROM n ORDER BY a, id
----
NULL 2
NULL 4
1 1
2 5
3 3

# UPDATE with NULL, then filter.
statement ok
UPDATE n SET a = 99 WHERE a IS NULL

query I
SELECT COUNT(*) FROM n WHERE a = 99
----
2
